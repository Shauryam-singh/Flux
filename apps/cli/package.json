{
  "name": "@ai-agent/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "cli": "dist/index.js"
  },
  "exports": {
    "./flux": {
      "types": "./dist/flux.d.ts",
      "import": "./dist/flux.js"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -b",
    "postbuild": "tsx ../../scripts/init-settings.ts",
    "start": "node dist/index.js",
    "init-settings": "tsx ../../scripts/init-settings.ts"
  },
  "dependencies": {
    "@ai-agent/agent": "workspace:*",
    "@ai-agent/config": "workspace:*",
    "@ai-agent/providers": "workspace:*",
    "@ai-agent/tools": "workspace:*",
    "@ai-agent/services-core": "workspace:*",
    "@ai-agent/services-chat": "workspace:*",
    "@ai-agent/services-coding": "workspace:*",
    "@ai-agent/services-search": "workspace:*",
    "@ai-agent/services-system": "workspace:*",
    "@ai-agent/services-reminders": "workspace:*",
    "@ai-agent/services-files": "workspace:*",
    "@ai-agent/services-notifications": "workspace:*",
    "@ai-agent/services-monitor": "workspace:*",
    "@ai-agent/services-automations": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
