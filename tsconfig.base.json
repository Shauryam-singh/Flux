{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "useDefineForClassFields": true,

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,
    "composite": true,
    "incremental": true,

    "esModuleInterop": true,

    "resolveJsonModule": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "noUncheckedIndexedAccess": true,

    "exactOptionalPropertyTypes": true
  }
}
